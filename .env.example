# --- GitHub authentication (required) ---
# A token with read access to Actions on the repositories you observe.
# Fine-grained token: "Actions: Read-only" + "Metadata: Read-only".
# Classic token: `repo` (private) or `public_repo` (public) is sufficient.
GITHUB_TOKEN=

# --- Repository selection (set at least one) ---
# Whole organisation: all non-archived repos are discovered automatically.
GITHUB_ORG=

# Explicit repositories, comma or whitespace separated.
# Use bare names (owner defaults to GITHUB_ORG) or full "owner/repo".
# Combined with GITHUB_ORG when both are set.
GITHUB_REPOS=

# --- Optional ---
# GitHub API base URL (change for GitHub Enterprise Server).
GITHUB_API_URL=https://api.github.com

# How long (seconds) GitHub responses are cached at the fetch layer.
GITHUB_REVALIDATE_SECONDS=30

# Secret configured identically on the GitHub organization webhook.
GITHUB_WEBHOOK_SECRET=
